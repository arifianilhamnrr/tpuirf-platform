[Unit]
Description=TPUIRF Machine Learning API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tpuirf-platform/python
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/home/ubuntu/tpuirf-platform/python/.venv/bin/gunicorn --workers 1 --threads 2 --timeout 120 --bind 127.0.0.1:5000 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
